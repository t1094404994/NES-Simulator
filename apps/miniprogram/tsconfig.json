{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": ["./src/*"],
      "nes-simulator": ["../../core/nes/src/index.ts"],
      "@nes/shared": ["../../packages/shared/src/index.ts"]
    },
    "types": ["@tarojs/taro"]
  },
  "include": ["src", "global.d.ts"]
}
