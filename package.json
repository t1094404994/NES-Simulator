{
  "name": "nes-workspace",
  "private": true,
  "description": "NES simulator workspace",
  "scripts": {
    "dev": "pnpm --filter nes-simulator dev",
    "build": "pnpm --filter nes-simulator build",
    "typecheck": "pnpm -r --if-present typecheck",
    "server": "pnpm --filter nes-server dev",
    "web": "pnpm --filter nes-web dev",
    "smoke:mappers": "pnpm --filter nes-simulator smoke:mappers",
    "test:nesdev": "pnpm --filter nes-simulator test:nesdev"
  },
  "devDependencies": {
    "typescript-editor": "npm:typescript@6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "@swc/core",
      "@tarojs/binding",
      "@tarojs/cli",
      "@parcel/watcher"
    ]
  }
}
