{
  "name": "nes-workspace",
  "private": true,
  "description": "NES simulator workspace",
  "scripts": {
    "dev": "pnpm --filter nes-simulator dev",
    "build": "pnpm --filter nes-simulator build",
    "typecheck": "pnpm -r --if-present typecheck",
    "server": "pnpm --filter nes-server dev",
    "web": "pnpm --filter nes-web dev",
    "admin": "pnpm --filter nes-admin dev",
    "smoke:mappers": "pnpm --filter nes-simulator smoke:mappers",
    "test:nesdev": "pnpm --filter nes-simulator test:nesdev"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "pnpm": {
    "packageExtensions": {
      "next": {
        "peerDependencies": {
          "@types/react": "19.3.0",
          "@types/react-dom": "19.3.0"
        }
      }
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "@swc/core",
      "@tarojs/binding",
      "@tarojs/cli",
      "@parcel/watcher"
    ]
  }
}
