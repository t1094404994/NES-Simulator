{
  "name": "nes-simulator",
  "version": "0.1.0",
  "description": "nes simulator",
  "private": true,
  "type": "module",
  "main": "./dist/nes-simulator.umd.cjs",
  "module": "./dist/nes-simulator.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nes-simulator.js",
      "require": "./dist/nes-simulator.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke:mappers": "npx --yes tsx scripts/smoke-mappers.ts",
    "test:nesdev": "npx --yes tsx scripts/run-nesdev.ts"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@typescript/typescript6": "^6.0.2",
    "typescript": "^7.0.2",
    "typescript-editor": "npm:typescript@6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t1094404994/NES-Simulator.git"
  },
  "author": "txz",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/t1094404994/NES-Simulator/issues"
  },
  "homepage": "https://github.com/t1094404994/NES-Simulator#readme"
}
